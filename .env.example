# Port (Render injects PORT automatically)
PORT=3000
NODE_ENV=development

# PostgreSQL connection string (Render / Neon / Supabase).
# Leave empty for local development to use built-in persistent local Postgres (PGlite).
DATABASE_URL=

# Secret for signing login cookies (Render auto-generates this via render.yaml)
JWT_SECRET=change-this-to-a-long-random-secret-key

# Admin account (auto-created on server startup)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=FinPlay Admin

# Initial retry limit per game per student
DEFAULT_MAX_ATTEMPTS=3
